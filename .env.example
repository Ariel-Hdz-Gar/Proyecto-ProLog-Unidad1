# Opción 1: Usar la URL de conexión completa
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/perritos_db

# Opción 2: Usar variables separadas (Si no defines DATABASE_URL)
# DB_USER=postgres
# DB_PASSWORD=tu_contraseña
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=perritos_db

# Configuración de imágenes (¡ATENCIÓN! Debe estar FUERA del código fuente de la aplicación)
RUTA_IMAGENES=C:\uploads\perritos

# Configuración de CORS
CORS_ORIGINS=*